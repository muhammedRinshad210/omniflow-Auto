# ==============================================================================
# OMNIFLOW CONFIGURATION TEMPLATE (.env.example)
# IMPORTANT: This file contains ONLY sanitized placeholder variables.
# NEVER commit real tokens, secrets, or encryption keys to git.
# In local development with Wrangler, copy this to .dev.vars for Worker secrets.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8787

# Master At-Rest Encryption Key (32-byte / 256-bit base64-encoded string)
# Used to encrypt sensitive Meta access tokens and platform sender IDs with AES-256-GCM.
# Generate locally via: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=PLACEHOLDER_BASE64_ENCRYPTION_KEY_32BYTES_REQUIRED

# Keyed HMAC Secret for Deterministic Lookup Hashes
# Used to compute deterministic HMAC-SHA256 hashes of contact identifiers for O(1) D1 lookups without revealing raw PII.
# Generate locally via: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
LOOKUP_HASH_SECRET=PLACEHOLDER_HEX_LOOKUP_HASH_SECRET_REQUIRED

# Meta Cloud API - Global App Secret & Webhook Verification (Fallback / Single-Tenant Default)
META_APP_SECRET=PLACEHOLDER_META_APP_SECRET
META_WEBHOOK_VERIFY_TOKEN=PLACEHOLDER_WEBHOOK_VERIFY_TOKEN

# Dashboard Admin Access (Phase 3 UI login password)
# This is the password you type into the OmniFlow dashboard login screen.
# Set it via: npx wrangler secret put ADMIN_PASSWORD  (or here for local dev)
ADMIN_PASSWORD=CHOOSE_A_STRONG_ADMIN_PASSWORD

# Cloudflare D1 Local / Remote Binding
# The binding name in wrangler.jsonc is "DB". For local dev, Wrangler manages SQLite automatically.
DB_BINDING=DB
